{
  "name": "midi-prober",
  "version": "0.1.0",
  "private": true,
  "description": "Companion app to midi-profiler: probes a real device over midi-core's live I/O and writes captured-traffic evidence for the profiler pipeline.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "midi-prober": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Lech Wojas",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  }
}
